        {
          "mode": "joystick",
          "path": "/user/hand/left/input/scroll",
          "inputs": {
            "position": {
              "output": "/actions/menu/in/scroll"
            }
          }
        },
        {
          "mode": "button",
          "path": "/user/hand/right/input/back",
          "inputs": {
            "click": {
              "output": "/actions/menu/in/back"
            }
          }
        },
        {
          "mode": "button",
          "path": "/user/hand/right/input/quick",
          "inputs": {
            "click": {
              "output": "/actions/menu/in/quick_menu_close"
            }
          }
        },
        {
          "mode": "joystick",
          "path": "/user/hand/right/input/scroll",
          "inputs": {
