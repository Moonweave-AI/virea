{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:virea:schema:dataset-manifest:0.1.0",
  "title": "VIREA Dataset Manifest",
  "type": "object",
  "required": ["schema_version", "dataset", "samples"],
  "properties": {
    "schema_version": { "const": "virea.dataset_manifest.v0.1.0" },
    "dataset": { "type": "string" },
    "samples": {
      "type": "array",
      "items": { "$ref": "urn:virea:schema:motion-sample:3.0.0" }
    }
  },
  "additionalProperties": true
}
