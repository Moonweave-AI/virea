{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:virea:schema:motion-sample:3.0.0",
  "title": "VIREA MotionSample v3",
  "type": "object",
  "required": ["schema_version", "artifact_schema_version", "motion_uid", "manifest_sha256", "array_sha256", "source_fingerprint", "sample", "source", "time", "skeleton", "annotations", "channels", "validation_warnings", "sidecars", "redactions", "canonical_artifact", "files", "quality", "processing", "preview", "hand_retarget"],
  "properties": {
    "schema_version": { "const": "virea.motion_sample.v3.0.0" },
    "artifact_schema_version": { "const": "virea.canonical_artifact.v3.0.0" },
    "motion_uid": { "type": "string" },
    "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "array_sha256": { "type": "object" },
    "source_fingerprint": { "type": "object" },
    "sample": { "type": "object" },
    "source": {
      "type": "object",
      "required": ["dataset", "source_id", "source_path", "source_format"],
      "properties": {
        "dataset": { "type": "string" },
        "source_id": { "type": "string" },
        "source_path": { "type": "string" },
        "source_format": { "type": "string" },
        "license_family": { "type": ["string", "null"] },
        "citation_keys": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "time": {
      "type": "object",
      "required": ["num_frames", "start_frame", "end_frame"],
      "properties": {
        "fps": { "type": ["number", "null"] },
        "num_frames": { "type": "integer", "minimum": 0 },
        "duration_sec": { "type": "number", "minimum": 0 },
        "start_frame": { "type": "integer", "minimum": 0 },
        "end_frame": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true
    },
    "skeleton": {
      "type": "object",
      "required": ["canonical_skeleton", "target_skeleton", "coordinate_system", "rotation_format", "unit", "rotation_semantics", "rest_source"],
      "properties": {
        "source_skeleton": { "type": ["string", "null"] },
        "canonical_skeleton": { "const": "virea_canonical_skeleton.v3" },
        "target_skeleton": { "type": "string" },
        "coordinate_system": { "type": "string" },
        "rotation_format": { "type": "string" },
        "unit": { "type": "string" },
        "rotation_semantics": { "const": "rest_relative_normalized_pose_delta" },
        "rest_source": { "const": "virea_canonical_rest.v3" }
      },
      "additionalProperties": true
    },
    "annotations": { "type": "array", "items": { "$ref": "urn:virea:schema:annotation:1.0.0" } },
    "channels": { "type": "array", "items": { "$ref": "urn:virea:schema:channel:1.0.0" } },
    "validation_warnings": { "type": "array", "items": { "type": "string" } },
    "sidecars": { "type": "array" },
    "redactions": { "type": "array" },
    "canonical_artifact": {
      "type": "object",
      "required": ["schema_version", "manifest", "manifest_sha256"],
      "properties": {
        "schema_version": { "const": "virea.canonical_artifact.v3.0.0" },
        "manifest": {
          "type": "string",
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$"
        },
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "object",
      "required": ["source_snapshot", "canonical_motion", "canonical_manifest", "vrm_positions", "quality_report", "metadata"],
      "properties": {
        "canonical_motion": { "type": "string" },
        "canonical_manifest": { "type": "string" },
        "source_snapshot": { "type": "string" },
        "vrm_positions": { "type": "string" },
        "quality_report": { "type": "string" },
        "metadata": { "type": "string" }
      },
      "additionalProperties": true
    },
    "quality": { "type": "object" },
    "hand_retarget": {
      "$ref": "urn:virea:schema:canonical-artifact:3.0.0#/$defs/handRetarget"
    },
    "processing": {
      "type": "object",
      "required": ["version", "profile", "profile_sha256", "artifact_schema_version"],
      "properties": {
        "version": { "const": "v0.4.0" },
        "profile": { "$ref": "urn:virea:schema:dataset-profile:2.0.0" },
        "profile_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "artifact_schema_version": { "const": "virea.canonical_artifact.v3.0.0" }
      },
      "additionalProperties": true
    },
    "preview": {
      "type": "object",
      "required": ["source_metadata", "processed_metadata"],
      "properties": {
        "source_metadata": { "type": "object" },
        "processed_metadata": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
