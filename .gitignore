# Dataset/VRM-derived showcase binaries remain local-only until each asset has
# an explicit reviewed publication decision. Historical v0.1 binaries were
# removed from the current tree; new media still requires deliberate promotion.
/doc/showcase/gifs/*.gif
/doc/showcase/videos/*.webm
/doc/showcase/screenshots/
/doc/showcase/render-output/
/doc/showcase/v3-output/

