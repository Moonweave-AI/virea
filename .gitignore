/.venv/
/node_modules/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
pytest-cache-files-*/
.mypy_cache/
.ruff_cache/

# Local configuration and credentials. Commit only reviewed examples.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# Large or generated data must stay outside Git.
/data/
/demo/raw/
/demo/processed/
/demo/manifest.json
/demo/verification-report.json
/demo/conversion-smoke.json
/demo/vrm-control-rest-audit.json
/runtime/
/outputs/
*.npz
*.npy
*.parquet
*.vrma
*.vrm
*.glb
*.gltf
*.pkl
*.pickle
*.wav
*.mp3
*.mp4

# Showcase binaries are local-only until the publication policy is `allowed`.
# Existing legacy files remain tracked for history; new/rebuilt media requires
# an explicit reviewed `git add -f` after the IP gate passes.
/doc/showcase/gifs/*.gif
/doc/showcase/videos/*.webm
/doc/showcase/screenshots/

# Local server logs and caches.
/logs/
/cache/
/tmp/
*.log
