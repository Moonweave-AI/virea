{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:virea:schema:execution_receipt:1.0.0",
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "uri": {
          "title": "Uri",
          "type": "string"
        },
        "byte_length": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Byte Length"
        },
        "dtype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dtype"
        },
        "shape": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shape"
        }
      },
      "required": [
        "name",
        "media_type",
        "uri"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "virea.execution_receipt.v1",
      "default": "virea.execution_receipt.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "command_id": {
      "minLength": 1,
      "title": "Command Id",
      "type": "string"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "epoch": {
      "minimum": 0,
      "title": "Epoch",
      "type": "integer"
    },
    "target_id": {
      "minLength": 1,
      "title": "Target Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "accepted",
        "completed",
        "interrupted",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "evidence": {
      "enum": [
        "planned",
        "generated",
        "validated",
        "sent",
        "device_ack",
        "observed_rendered",
        "semantically_satisfied"
      ],
      "title": "Evidence",
      "type": "string"
    },
    "detail": {
      "default": "",
      "title": "Detail",
      "type": "string"
    },
    "evidence_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Evidence Refs",
      "type": "array"
    }
  },
  "required": [
    "command_id",
    "session_id",
    "epoch",
    "target_id",
    "status",
    "evidence"
  ],
  "title": "ExecutionReceiptV1",
  "type": "object"
}
