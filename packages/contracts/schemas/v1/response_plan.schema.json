{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:virea:schema:response_plan:1.0.0",
  "$defs": {
    "MotionSegment": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "start_seconds": {
          "exclusiveMaximum": 180,
          "minimum": 0,
          "title": "Start Seconds",
          "type": "number"
        },
        "duration_seconds": {
          "exclusiveMinimum": 0,
          "maximum": 180,
          "title": "Duration Seconds",
          "type": "number"
        },
        "prompt": {
          "maxLength": 120,
          "minLength": 1,
          "pattern": "^[A-Za-z][A-Za-z0-9 ,'\\-]*[.!]?$",
          "title": "Prompt",
          "type": "string"
        },
        "label": {
          "default": "",
          "maxLength": 80,
          "title": "Label",
          "type": "string"
        },
        "speech_gestures": {
          "default": false,
          "title": "Speech Gestures",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "start_seconds",
        "duration_seconds",
        "prompt"
      ],
      "title": "MotionSegment",
      "type": "object"
    },
    "SpeechClip": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "start_seconds": {
          "anyOf": [
            {
              "exclusiveMaximum": 180,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Seconds"
        },
        "after_clip": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After Clip"
        },
        "gap_seconds": {
          "default": 0,
          "maximum": 180,
          "minimum": 0,
          "title": "Gap Seconds",
          "type": "number"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "SpeechClip",
      "type": "object"
    },
    "ToolIntentV1": {
      "additionalProperties": false,
      "properties": {
        "capability": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Arguments",
          "type": "object"
        }
      },
      "required": [
        "capability"
      ],
      "title": "ToolIntentV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "virea.response_plan.v1",
      "default": "virea.response_plan.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "plan_id": {
      "minLength": 1,
      "title": "Plan Id",
      "type": "string"
    },
    "utterances": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SpeechClip"
      },
      "title": "Utterances",
      "type": "array"
    },
    "motion_actions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/MotionSegment"
      },
      "title": "Motion Actions",
      "type": "array"
    },
    "tool_intents": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ToolIntentV1"
      },
      "title": "Tool Intents",
      "type": "array"
    },
    "idle_prompt": {
      "default": "A person stands calmly, breathing naturally.",
      "title": "Idle Prompt",
      "type": "string"
    },
    "seed": {
      "default": 42,
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Seed",
      "type": "integer"
    }
  },
  "required": [
    "plan_id"
  ],
  "title": "ResponsePlanV1",
  "type": "object"
}
